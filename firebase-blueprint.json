{
  "entities": {
    "tailor_orders": {
      "title": "Tailor Orders",
      "description": "Tailoring orders with customer, measurements, assigned tailor, stage tracking and payment settlement",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "isRepeatCustomer": { "type": "boolean" },
        "garmentType": { "type": "string" },
        "orderCategory": { "type": "string" },
        "subTypeStyle": { "type": "string" },
        "genderCategory": { "type": "string" },
        "measurementMode": { "type": "string" },
        "measurements": { "type": "object" },
        "receiptImageUrl": { "type": "string" },
        "referenceGarmentUrl": { "type": "string" },
        "specialNotes": { "type": "string" },
        "voiceNoteUrl": { "type": "string" },
        "voiceNoteDurationSec": { "type": "number" },
        "fabricPhotos": { "type": "array" },
        "stitchedPhotos": { "type": "array" },
        "deliveredDate": { "type": "string" },
        "totalAmount": { "type": "number" },
        "advancePaid": { "type": "number" },
        "balanceDue": { "type": "number" },
        "paymentMode": { "type": "string" },
        "paymentHistory": { "type": "array" },
        "status": { "type": "string" },
        "createdDate": { "type": "string" },
        "createdTime": { "type": "string" },
        "createdBy": { "type": "string" },
        "dueDate": { "type": "string" },
        "dueTime": { "type": "string" },
        "assignedTailor": { "type": "string" },
        "estimatedHours": { "type": "number" },
        "offerMessage": { "type": "string" },
        "isOverdue": { "type": "boolean" },
        "daysOverdue": { "type": "number" },
        "isArchived": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "customerName", "customerPhone", "garmentType", "totalAmount", "status", "dueDate"]
    },
    "tailor_customers": {
      "title": "Tailor Customers",
      "description": "Customer directory with saved measurements and order history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "isRepeat": { "type": "boolean" },
        "ordersCount": { "type": "number" },
        "lastOrderDate": { "type": "string" },
        "totalSpent": { "type": "number" },
        "gender": { "type": "string" },
        "measurements": { "type": "object" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "phone"]
    },
    "tailor_staff": {
      "title": "Staff Tailors",
      "description": "Tailor workshop staff roster for order assignment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string" },
        "initials": { "type": "string" },
        "activeOrdersCount": { "type": "number" }
      },
      "required": ["id", "name", "role"]
    },
    "shop_profiles": {
      "title": "Shop Profile",
      "description": "Boutique tailoring shop branding, address, and UPI payment settings",
      "type": "object",
      "properties": {
        "shopName": { "type": "string" },
        "ownerName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "address": { "type": "string" },
        "googleMapUrl": { "type": "string" },
        "upiId": { "type": "string" },
        "upiQrCodeUrl": { "type": "string" },
        "gpayPhonePeNumber": { "type": "string" },
        "lastSyncedTimestamp": { "type": "string" }
      },
      "required": ["shopName", "ownerName"]
    }
  },
  "firestore": {
    "tailor_orders": {
      "schema": "tailor_orders",
      "description": "Master tailoring orders collection"
    },
    "tailor_customers": {
      "schema": "tailor_customers",
      "description": "Customer profiles and measurements"
    },
    "tailor_staff": {
      "schema": "tailor_staff",
      "description": "Staff tailors roster"
    },
    "shop_profiles": {
      "schema": "shop_profiles",
      "description": "Shop profile and business configuration"
    }
  }
}
