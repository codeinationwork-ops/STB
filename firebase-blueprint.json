{
  "entities": {
    "products": {
      "title": "Products",
      "description": "Direct D2C Brand Catalog",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "directPrice": { "type": "number" },
        "marketplacePrice": { "type": "number" },
        "category": { "type": "string" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "inStock": { "type": "boolean" },
        "images": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "specs": { "type": "array" }
      },
      "required": ["name", "brand", "directPrice", "marketplacePrice", "category"]
    },
    "users": {
      "title": "User Profile",
      "description": "Authenticated user profiles stored from Google Auth",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "avatar": { "type": "string" },
        "role": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "name"]
    },
    "wishlists": {
      "title": "Wishlist",
      "description": "User Wishlist items",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "productId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "productId"]
    },
    "searches": {
      "title": "Search History",
      "description": "Logged AI search queries",
      "type": "object",
      "properties": {
        "query": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "brand_removal_requests": {
      "title": "Brand Removal Requests",
      "description": "Requests from brand owners to remove their brand listing",
      "type": "object",
      "properties": {
        "brandName": { "type": "string" },
        "websiteUrl": { "type": "string" },
        "contactName": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contactPhone": { "type": "string" },
        "reason": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["brandName", "contactEmail", "contactName"]
    },
    "brand_addition_requests": {
      "title": "Brand Addition Requests",
      "description": "Requests from brand owners to add/list their brand",
      "type": "object",
      "properties": {
        "brandName": { "type": "string" },
        "websiteUrl": { "type": "string" },
        "contactName": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contactPhone": { "type": "string" },
        "category": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["brandName", "websiteUrl", "contactEmail", "contactName"]
    },
    "shopify_stores": {
      "title": "Shopify Stores",
      "description": "Registered Shopify stores connected for product scraping and API integration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "store_domain": { "type": "string" },
        "store_name": { "type": "string" },
        "api_key": { "type": "string" },
        "access_token": { "type": "string" },
        "status": { "type": "string" },
        "total_products": { "type": "number" },
        "last_scraped_at": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["store_domain", "store_name"]
    },
    "shopify_products": {
      "title": "Shopify Products",
      "description": "Scraped product items from Shopify .json endpoints with variant IDs and discount calculation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "variant_id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "images": { "type": "array" },
        "price": { "type": "number" },
        "compare_at_price": { "type": "number" },
        "discount_percentage": { "type": "number" },
        "store_domain": { "type": "string" },
        "cart_permalink": { "type": "string" },
        "vendor": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["title", "price", "store_domain", "variant_id"]
    },
    "auto_products": {
      "title": "Auto Products",
      "description": "Products harvested automatically by AI Product Reader pipeline",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "object" },
        "product": { "type": "object" },
        "pricing": { "type": "object" },
        "fashion": { "type": "object" },
        "collections": { "type": "array" },
        "images": { "type": "object" },
        "ai": { "type": "object" },
        "crawler": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["source", "product", "pricing", "images"]
    },
    "crawl_jobs": {
      "title": "Crawl Jobs",
      "description": "Job tracker for multi-URL auto product crawler queue",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "status": { "type": "string" },
        "websitesCount": { "type": "number" },
        "productsFound": { "type": "number" },
        "productsProcessed": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "status"]
    }
  },
  "firestore": {
    "products": {
      "schema": "products",
      "description": "Master products collection"
    },
    "users": {
      "schema": "users",
      "description": "User profiles"
    },
    "wishlists": {
      "schema": "wishlists",
      "description": "User wishlists"
    },
    "shopify_stores": {
      "schema": "shopify_stores",
      "description": "Connected Shopify stores database"
    },
    "shopify_products": {
      "schema": "shopify_products",
      "description": "Harvested Shopify products collection"
    },
    "auto_products": {
      "schema": "auto_products",
      "description": "Auto crawler harvested product catalog"
    },
    "crawl_jobs": {
      "schema": "crawl_jobs",
      "description": "Auto crawler job tracker queue"
    }
  }
}

