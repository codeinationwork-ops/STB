  "firestore": {
    "Subscription/{subscriptionId}": {
      "schema": "Subscription",
      "description": "Master subscription and payment registry storing all subscription payment proofs and approval statuses"
    },
    "subscriptions/{subscriptionId}": {
      "schema": "Subscription",
      "description": "Canonical alias collection for boutique subscriptions"
    },
    "boutiques/{boutiqueId}": {
      "schema": "boutiques",
      "description": "Single consolidated boutique registry storing all boutique details, owner credentials, address, and config"
    },
    "orders/{orderId}": {
      "schema": "tailor_orders",
      "description": "Primary orders collection holding master order records"
    },
    "stitch/{orderId}": {
      "schema": "tailor_orders",
      "description": "Direct partition collection for custom stitching orders"
    },
    "alter/{orderId}": {
      "schema": "tailor_orders",
      "description": "Direct partition collection for alterations & fitting orders"
    },
    "sale/{orderId}": {
      "schema": "tailor_orders",
      "description": "Direct partition collection for direct retail garment sales"
    },
    "customers/{customerId}": {
      "schema": "customers",
      "description": "Unified master customer directory with saved measurements, contact details, and order history"
    },
    "tailor_staff/{staffId}": {
      "schema": "tailor_staff",
      "description": "Staff tailors and karigar roster"
    },
    "appointments/{appointmentId}": {
      "schema": "appointments",
      "description": "Single consolidated customer appointments collection"
    },
    "inventory/{itemId}": {
      "schema": "inventory",
